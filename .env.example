# Copie para .env e ajuste. JWT_SECRET deve ser o mesmo da API principal (fiap-mecanica).
DB_ROOT_PASSWORD=root
DB_USERNAME=root
DB_PASSWORD=root
JWT_SECRET=
# Segredo do token de servico (fiap-mecanica -> estoque). Deve ser o mesmo do fiap-mecanica e DIFERENTE do JWT_SECRET.
SERVICE_JWT_SECRET=
# RabbitMQ: o broker sobe no docker-compose do fiap-mecanica; usuario/senha iguais a RABBITMQ_ESTOQUE_* de la.
RABBITMQ_VHOST=fiap
RABBITMQ_USERNAME=estoque
RABBITMQ_PASSWORD=troque-por-uma-senha
